# SIP Grok Voice — copy to .env next to sip-to-ai and fill in YOUR values.
# Never commit this file with secrets.

# --- Grok Voice (xAI) ---
AI_VENDOR=grok
XAI_API_KEY=
GROK_VOICE=leo
GROK_MODEL=grok-voice-think-fast-2.0
GROK_WS_ENDPOINT=wss://api.x.ai/v1/realtime
AGENT_PROMPT_FILE=agent_prompt.yaml

# --- SIP bind ---
SIP_DOMAIN=0.0.0.0
SIP_PORT=5060
SIP_TRANSPORT_TYPE=udp

# --- Registrar (your SIP provider) ---
SIP_REGISTER=1
SIP_REG_HOST=
SIP_REG_USER=
SIP_REG_PASS=
SIP_REG_REALM=
SIP_REG_EXPIRES=300

# Blind transfer for human support (sip:user@host or a bare number)
SIP_TRANSFER_TARGET=
# Spoken EXACTLY before REFER. Keep it short enough to finish before the 8s wait.
TRANSFER_ANNOUNCE=Please hold a moment, I am transferring you now. Have a nice day.

# Only these source IPs may INVITE (comma-separated). Empty = any (not recommended).
SIP_INVITE_ALLOW=
SIP_MAX_CALLS=2

# --- Optional: email transcript + stereo WAV after hangup ---
CALL_RECORD_EMAIL=0
CALL_RECORD_TO=
CALL_RECORD_FROM=
CALL_RECORD_DIR=recordings

LOG_LEVEL=INFO
LOG_FORMAT=json
